generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  phone        String?
  role         String   @default("PATIENT")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  patient Patient?
  doctor  Doctor?
  staff   Staff?

  @@map("users")
}

model Hospital {
  id             String   @id @default(uuid())
  name           String
  logo           String?
  address        String
  city           String
  state          String?
  phone          String
  emergencyPhone String?  @map("emergency_phone")
  email          String?
  openingHours   String?  @map("opening_hours")
  closingHours   String?  @map("closing_hours")
  isOpen         Boolean  @default(true) @map("is_open")
  status         String   @default("ACTIVE")
  registrationNo String?  @map("registration_no")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  departments  Department[]
  doctors      Doctor[]
  staff        Staff[]
  queues       Queue[]
  appointments Appointment[]
  doctorInvites DoctorInvite[]

  @@map("hospitals")
}

model Department {
  id          String   @id @default(uuid())
  name        String
  description String?
  hospitalId  String   @map("hospital_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  doctors      Doctor[]
  appointments Appointment[]

  @@unique([name, hospitalId])
  @@map("departments")
}

model Doctor {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  hospitalId        String   @map("hospital_id")
  departmentId      String   @map("department_id")
  specialization    String?
  qualification     String?
  experience        Int?
  licenseNumber     String?  @map("license_number")
  consultationFee   Float?   @map("consultation_fee")
  workingDays       String   @default("Mon,Tue,Wed,Thu,Fri") @map("working_days")
  startTime         String   @default("09:00") @map("start_time")
  endTime           String   @default("17:00") @map("end_time")
  maxPatientsPerDay Int      @default(30) @map("max_patients_per_day")
  breakStart        String?  @map("break_start")
  breakEnd          String?  @map("break_end")
  status            String   @default("OFFLINE")
  profilePhoto      String?  @map("profile_photo")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  queues       Queue[]
  changeRequests DoctorChangeRequest[]

  @@map("doctors")
}

model Patient {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  dateOfBirth String?  @map("date_of_birth")
  gender      String?
  bloodGroup  String?  @map("blood_group")
  address     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("patients")
}

model Staff {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  hospitalId String   @map("hospital_id")
  position   String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@map("staff")
}

model Appointment {
  id                String    @id @default(uuid())
  patientId         String    @map("patient_id")
  doctorId          String    @map("doctor_id")
  hospitalId        String    @map("hospital_id")
  departmentId      String    @map("department_id")
  date              DateTime  @map("appointment_date")
  slotTime          String    @map("slot_time")
  tokenNumber       String    @map("token_number")
  status            String    @default("BOOKED")
  queuePosition     Int?      @map("queue_position")
  estimatedWait     Int?      @map("estimated_wait_minutes")
  consultationStart DateTime? @map("consultation_start")
  consultationEnd   DateTime? @map("consultation_end")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital      Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([doctorId, date, tokenNumber])
  @@map("appointments")
}

model Queue {
  id           String   @id @default(uuid())
  doctorId     String   @map("doctor_id")
  hospitalId   String   @map("hospital_id")
  date         DateTime @map("queue_date")
  currentToken String?  @map("current_token")
  prefix       String   @default("A")
  totalServed  Int      @default(0) @map("total_served")
  totalWaiting Int      @default(0) @map("total_waiting")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  doctor   Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date])
  @@map("queues")
}

model Notification {
  id            String   @id @default(uuid())
  appointmentId String?  @map("appointment_id")
  userId        String   @map("user_id")
  title         String
  message       String
  type          String
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   String?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model HospitalRegistrationRequest {
  id                String    @id @default(uuid())
  hospitalName      String
  address           String
  city              String
  state             String?
  phone             String
  email             String
  registrationNo    String?   @map("registration_no")
  adminName         String
  adminEmail        String    @unique @map("admin_email")
  adminPhone        String?   @map("admin_phone")
  adminPasswordHash String    @map("admin_password_hash")
  status            String    @default("PENDING_APPROVAL")
  reviewComment     String?   @map("review_comment")
  reviewedBy        String?   @map("reviewed_by")
  reviewedAt        DateTime? @map("reviewed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("hospital_registration_requests")
}

model DoctorInvite {
  id         String    @id @default(uuid())
  hospitalId String    @map("hospital_id")
  email      String
  name       String
  token      String    @unique
  details    String    @default("{}")
  status     String    @default("PENDING")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  invitedBy  String    @map("invited_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId, status])
  @@map("doctor_invites")
}

model DoctorChangeRequest {
  id            String    @id @default(uuid())
  doctorId      String    @map("doctor_id")
  requestedData String    @map("requested_data")
  status        String    @default("PENDING")
  reviewComment String?   @map("review_comment")
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, status])
  @@map("doctor_change_requests")
}
